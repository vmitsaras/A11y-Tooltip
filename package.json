{
  "name": "a11y-tooltip",
  "version": "0.1.0",
  "description": "A small, progressively enhanced accessible tooltip with TypeScript-first APIs and zero runtime dependencies.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./addons": {
      "types": "./dist/addons/index.d.ts",
      "import": "./dist/addons/index.js"
    },
    "./docs": {
      "types": "./dist/docs.d.ts",
      "import": "./dist/docs.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json",
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics/index.d.ts",
      "import": "./dist/diagnostics/index.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "ACCESSIBILITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "copy:assets": "node -e \"const fs = require('node:fs'); if (fs.existsSync('src/styles.css')) { fs.mkdirSync('dist', { recursive: true }); fs.copyFileSync('src/styles.css', 'dist/styles.css'); }\"",
    "build:dist": "npm run clean && tsdown && npm run copy:assets",
    "pages:generate": "node scripts/build-pages.mjs",
    "pages:build": "npm run build:dist && npm run pages:generate",
    "build": "npm run pages:build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack:check": "npm pack --dry-run --cache ./.npm-cache",
    "prepack": "npm run build:dist",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run test && npm run typecheck && npm run build:dist && changeset publish",
    "test:browser": "playwright test",
    "test:all": "npm test && npm run test:browser"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vmitsaras/A11y-Tooltip.git"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "tooltip",
    "typescript",
    "wcag",
    "aria"
  ],
  "author": "Vasileios Mitsaras",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/vmitsaras/A11y-Tooltip/issues"
  },
  "homepage": "https://vmitsaras.github.io/A11y-Tooltip/",
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "happy-dom": "^20.11.2",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "@playwright/test": "^1.63.0"
  }
}
